# Copia este archivo como includes/.env para desarrollo local.
APP_ENV=desarrollo

# Base de datos de cotizaciones
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cotizaciones
DB_USER=portal_canastillas
DB_PASSWORD=

# Canastillas de la Baja en la tabla empresas
EMPRESA_ID=2

# Servicio de cotizaciones que sirve /public/image y /portal/entregas/foto
COTIZACIONES_URL=http://127.0.0.1:8001
# Mismo valor que PORTAL_FOTOS_SECRETO en cotizaciones
PORTAL_FOTOS_SECRETO=
# 1 si el sitio está detrás de ingress-nginx (usa X-Real-IP para el límite de login)
CONFIAR_PROXY=0
